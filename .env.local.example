# EchoFlow Spotify OAuth Configuration
# Obtain your Client ID from https://developer.spotify.com/dashboard
# Add http://localhost:3000/callback to your Spotify App Redirect URIs

NEXT_PUBLIC_SPOTIFY_CLIENT_ID=your_spotify_client_id_here
NEXT_PUBLIC_SPOTIFY_REDIRECT_URI=http://localhost:3000/callback

# NOTE: Never provide a client secret here. EchoFlow uses PKCE (Proof Key for Code Exchange)
# which does not require, nor should it ever include, a Spotify client secret in the browser.
